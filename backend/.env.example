# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# Security
JWT_SECRET_KEY=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-sonnet-20240229

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Frontend URLs (for CORS)
FRONTEND_URL_BUYER=http://localhost:3000
FRONTEND_URL_SELLER=http://localhost:3001
FRONTEND_URL_AGENT=http://localhost:3002
FRONTEND_URL_ADMIN=http://localhost:3003
